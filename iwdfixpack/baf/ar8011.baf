IF
  Dead("MaidenIlmadia")
  Global("%group_2_hostile%","AR8011",0) // fire giant group
THEN
	RESPONSE #100
		SetGlobal("%group_2_hostile%","AR8011",1)
END

IF
  Allegiance("MaidenIlmadia",ENEMY)
  Global("%group_2_hostile%","AR8011",0) // fire giant group
THEN
	RESPONSE #100
		SetGlobal("%group_2_hostile%","AR8011",1)
END
